						"outputs": [
							{
								"referenceName": "DS_TGT_ETE_JASON",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
