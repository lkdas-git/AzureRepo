{
	"name": "PL_ETE_EXCEL",
	"properties": {
		"activities": [
			{
				"name": "Get_Meta_EXCL",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_ETE_EXCL_GMD",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "Filter_ETE_EXCL",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Get_Meta_EXCL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get_Meta_EXCL').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@startsWith(toLower(item().name), 'order_reviews_dataset')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEach_ETE_EXCL",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Filter_ETE_EXCL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Filter_ETE_EXCL').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "IF_ETE_EXCL_CSV",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@endsWith(toLower(item().name), '.xlsx')",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "CPY_ETE_EXL_ADLS",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "ExcelSource",
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": true,
													"enablePartitionDiscovery": false
												}
											},
											"sink": {
												"type": "ParquetSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "ParquetWriteSettings"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "DS_SRC_ETE_EXCL",
												"type": "DatasetReference"
											}
										],
										"outputs": [
											{
												"referenceName": "DS_TGT_ETE_EXCL",
												"type": "DatasetReference"
											}
										]
									}
								]
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}