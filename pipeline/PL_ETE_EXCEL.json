{
	"name": "PL_ETE_EXCEL",
	"properties": {
		"activities": [
			{
				"name": "Get_Meta_EXCL",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_ETE_EXCL_GMD",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "Filter_ETE_EXCL",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Get_Meta_EXCL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get_Meta_EXCL').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@startsWith(toLower(item().name), 'order_reviews_dataset')",
						"type": "Expression"
					}
				}
			}
		],
		"annotations": []
	}
}